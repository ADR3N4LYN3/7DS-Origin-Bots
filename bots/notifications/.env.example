# ── Discord ──────────────────────────────────────────────────────────
# Token & Client ID du bot (Discord Developer Portal > votre application)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# ID du serveur où enregistrer les commandes slash
DISCORD_GUILD_ID=
# Rôle autorisé à gérer les notifications (/notif)
DISCORD_ADMIN_ROLE_ID=

# ── Twitch ───────────────────────────────────────────────────────────
# Créez une application sur https://dev.twitch.tv/console/apps
# (OAuth Redirect URL: http://localhost — non utilisée, mais requise)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Polling (optionnel) ──────────────────────────────────────────────
# Intervalle de vérification en secondes
YOUTUBE_POLL_SECONDS=180
TWITCH_POLL_SECONDS=60

# ── Emojis des boutons (optionnel) ───────────────────────────────────
# Laisser vide = emoji par défaut. Pour un emoji custom de ton serveur,
# tape \:nom_emoji: dans Discord pour obtenir la forme <:nom:id>, puis colle-la.
# (emoji animé = <a:nom:id>)
BTN_EMOJI_YOUTUBE=▶️
BTN_EMOJI_YOUTUBE_SUB=🔔
BTN_EMOJI_TWITCH=🔴
BTN_EMOJI_TWITCH_CHANNEL=💜
